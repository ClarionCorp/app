{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:default",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$HOME/AppData/Local/OmegaStrikers/identity.json" },
        { "path": "$HOME/AppData/Local/OmegaStrikers/Saved/Logs/OmegaStrikers.log" },
        { "path": "**/steamapps/common/OmegaStrikers/OmegaStrikers/Binaries/Win64/**" },
        { "path": "$HOME/.steam/steam/steamapps/common/OmegaStrikers/OmegaStrikers/Binaries/Win64/**"},
        { "path": "$HOME/.steam/steam/steamapps/compatdata/1869590/pfx/drive_c/users/steamuser/AppData/Local/OmegaStrikers/identity.json" },
        { "path": "$HOME/.steam/steam/steamapps/compatdata/1869590/pfx/drive_c/users/steamuser/AppData/Local/OmegaStrikers/Saved/Logs/OmegaStrikers.log" },
        { "path": "$APPDATA/logs/latest.log" }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "**/steamapps/common/OmegaStrikers/OmegaStrikers/Binaries/Win64/**" },
        { "path": "$HOME/.steam/steam/steamapps/common/OmegaStrikers/OmegaStrikers/Binaries/Win64/**"}
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        { "path": "**/steamapps/common/OmegaStrikers/OmegaStrikers/Binaries/Win64/**" },
        { "path": "$HOME/.local/share/**"},
        { "path": "$HOME/.steam/steam/steamapps/common/OmegaStrikers/OmegaStrikers/Binaries/Win64/**"}
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$HOME/AppData/Local/OmegaStrikers/identity.json" },
        { "path": "$HOME/AppData/Local/OmegaStrikers/Saved/Logs/OmegaStrikers.log" },
        { "path": "$TEMP/**" },
        { "path": "**/steamapps/common/OmegaStrikers/OmegaStrikers/Binaries/Win64/**" },
        { "path": "$HOME/.steam/steam/steamapps/common/OmegaStrikers/**"},
        { "path": "$HOME/.steam/steam/steamapps/compatdata/1869590/pfx/drive_c/users/steamuser/AppData/Local/OmegaStrikers/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        { "path": "$TEMP/**" },
        { "path": "**/steamapps/common/OmegaStrikers/OmegaStrikers/Binaries/Win64/**" },
        { "path": "$HOME/.steam/steam/steamapps/common/OmegaStrikers/OmegaStrikers/Binaries/Win64/**"}
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        { "path": "$TEMP/**" },
        { "path": "**/steamapps/common/OmegaStrikers/OmegaStrikers/Binaries/Win64/**" },
        { "path": "$HOME/.steam/steam/steamapps/common/OmegaStrikers/OmegaStrikers/Binaries/Win64/**"}
      ]
    },
    "fs:allow-read-dir",
    "fs:allow-rename",
    {
      "identifier": "fs:allow-remove",
      "allow": [
        { "path": "**/steamapps/common/OmegaStrikers/OmegaStrikers/Binaries/Win64/**" },
        { "path": "$HOME/.steam/steam/steamapps/common/OmegaStrikers/OmegaStrikers/Binaries/Win64/**"}
      ]
    },
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**/*" }]
    },
    "dialog:default",
    "os:default",
    "process:default",
    "drpc:default",
    "drpc:allow-is-running",
    "drpc:allow-set-activity",
    "libsql:default",
    "core:window:allow-set-title",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://github.com/*" },
        { "url": "https://api.github.com/*" },
        { "url": "https://api.clarioncorp.net/*" },
        { "url": "https://clarioncorp.net/api/*" },
        { "url": "https://api.aimis.app/*" },
        { "url": "https://prometheus-proxy.odysseyinteractive.gg/api/*" },
        { "url": "http://localhost:12240/*" }
      ]
    }
  ]
}