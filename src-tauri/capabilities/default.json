{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:default",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$HOME/Desktop/**" },
        { "path": "$HOME/AppData/Local/OmegaStrikers/identity.json" },
        { "path": "$HOME/AppData/Local/OmegaStrikers/Saved/Logs/OmegaStrikers.log" }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$HOME/Desktop/**" },
        { "path": "$HOME/AppData/Local/OmegaStrikers/identity.json" },
        { "path": "$HOME/AppData/Local/OmegaStrikers/Saved/Logs/OmegaStrikers.log" },
        { "path": "$TEMP/**" },
        { "path": "**/steamapps/common/OmegaStrikers/OmegaStrikers/Binaries/Win64/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        { "path": "$TEMP/**" },
        { "path": "**/steamapps/common/OmegaStrikers/OmegaStrikers/Binaries/Win64/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        { "path": "$TEMP/**" },
        { "path": "**/steamapps/common/OmegaStrikers/OmegaStrikers/Binaries/Win64/**" }
      ]
    },
    "fs:allow-read-dir",
    "fs:allow-rename",
    {
      "identifier": "fs:allow-remove",
      "allow": [
        { "path": "**/steamapps/common/OmegaStrikers/OmegaStrikers/Binaries/Win64/**" }
      ]
    },
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**/*" }]
    },
    "dialog:default",
    "os:default",
    "process:default",
    "drpc:default",
    "drpc:allow-is-running",
    "drpc:allow-set-activity",
    "sql:default",
    "sql:allow-load",
    "sql:allow-select",
    "sql:allow-execute",
    "core:window:allow-set-title",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://github.com/*" },
        { "url": "https://api.github.com/*" },
        { "url": "https://api.clarioncorp.net/*" },
        { "url": "https://clarioncorp.net/api/*" }
      ]
    }
  ]
}